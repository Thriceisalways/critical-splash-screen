<div class="critical-splash-screen-config">
  <style>
    .critical-splash-screen-config {
      overflow-y: auto;
      height: 100%;
      box-sizing: border-box;
      padding-right: 8px;
    }
    .critical-splash-screen-config details {
      border: 1px solid var(--color-border-light-tertiary, #7a7971);
      border-radius: 4px;
      padding: 8px 10px;
      margin-bottom: 10px;
    }
    .critical-splash-screen-config summary {
      cursor: pointer;
      font-weight: bold;
      padding: 4px 0;
    }
    .critical-splash-screen-config .hint {
      opacity: 0.75;
      font-size: 0.9em;
      margin-top: -4px;
    }
    .critical-splash-screen-config .char-card {
      border: 1px solid var(--color-border-light-tertiary, #7a7971);
      border-radius: 6px;
      padding: 10px 12px;
      margin-bottom: 12px;
      background: rgba(0, 0, 0, 0.12);
    }
    .critical-splash-screen-config .char-card-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--color-border-light-tertiary, #7a7971);
    }
    .critical-splash-screen-config .char-card-header select {
      flex: 1 1 auto;
      min-width: 0;
    }
    .critical-splash-screen-config .char-card-header .threshold-field {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
    }
    .critical-splash-screen-config .char-card-header .threshold-field input {
      width: 50px;
      text-align: center;
    }
    .critical-splash-screen-config .char-card-header button[data-action="deleteRow"] {
      flex: 0 0 auto;
    }
    .critical-splash-screen-config .char-card-body {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 16px;
    }
    .critical-splash-screen-config .char-card-col h4 {
      margin: 0 0 6px 0;
      font-size: 0.95em;
      opacity: 0.85;
    }
    .critical-splash-screen-config .char-card-col .form-group {
      margin-bottom: 8px;
    }
    .critical-splash-screen-config .char-card-col label {
      font-size: 0.85em;
      opacity: 0.75;
      display: block;
      margin-bottom: 2px;
    }
    .critical-splash-screen-config .form-fields input[type="text"] {
      flex: 1 1 auto;
      min-width: 0;
    }
  </style>

  <p>Configure crit (nat 20) and fumble (nat 1) images and sounds per character, plus the global screen scale.</p>

  <details open>
    <summary>Global Settings</summary>
    <div class="form-group">
      <label>Screen Scale (fraction of screen size, e.g. 0.3 = 30%)</label>
      <input type="number" name="scale" value="{{scale}}" step="0.05" min="0.05" max="3">
    </div>
    <div class="form-group">
      <label>Default Crit Image (used if a character isn't listed below)</label>
      <div class="form-fields">
        <input type="text" name="defaultCrit" value="{{defaultCrit}}">
        <button type="button" data-action="pickImage" data-target="defaultCrit"><i class="fas fa-file-import"></i></button>
      </div>
    </div>
    <div class="form-group">
      <label>Default Fumble Image (used if a character isn't listed below)</label>
      <div class="form-fields">
        <input type="text" name="defaultFumble" value="{{defaultFumble}}">
        <button type="button" data-action="pickImage" data-target="defaultFumble"><i class="fas fa-file-import"></i></button>
      </div>
    </div>
    <div class="form-group">
      <label>Death Sound Folder (a random file plays when a token gets the "dead" status)</label>
      <div class="form-fields">
        <input type="text" name="deathSoundFolder" value="{{deathSoundFolder}}">
        <button type="button" data-action="pickImage" data-target="deathSoundFolder" data-picker-type="folder"><i class="fas fa-folder-open"></i></button>
      </div>
    </div>
    <div class="form-group">
      <label>Crit Sound Folder (backup: random file plays on a crit if that character has no custom crit sound set)</label>
      <div class="form-fields">
        <input type="text" name="critSoundFolder" value="{{critSoundFolder}}">
        <button type="button" data-action="pickImage" data-target="critSoundFolder" data-picker-type="folder"><i class="fas fa-folder-open"></i></button>
      </div>
    </div>
    <div class="form-group">
      <label>Fumble Sound Folder (backup: random file plays on a fumble if that character has no custom fumble sound set)</label>
      <div class="form-fields">
        <input type="text" name="fumbleSoundFolder" value="{{fumbleSoundFolder}}">
        <button type="button" data-action="pickImage" data-target="fumbleSoundFolder" data-picker-type="folder"><i class="fas fa-folder-open"></i></button>
      </div>
    </div>
  </details>

  <details open>
    <summary>Per-Character Setup</summary>
    <p class="hint">
      Sounds only play if a splash image is also set for that crit or fumble.
      Crit threshold is optional — leave blank to use a normal nat 20 (or the character's own
      "weaponCriticalThreshold" flag, e.g. from Improved Critical, if lower). Set it manually
      only to override that.
    </p>

    {{#each rows}}
    <div class="char-card">
      <div class="char-card-header">
        <select name="rows.{{@index}}.actorId">
          {{#each actorOptions}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
        <div class="threshold-field">
          <label for="crit-threshold-{{@index}}" title="Crit on this value or higher">Crit on</label>
          <input type="number" id="crit-threshold-{{@index}}" name="rows.{{@index}}.critThreshold"
                 value="{{critThreshold}}" min="2" max="20" placeholder="20">
        </div>
        <button type="button" data-action="deleteRow" data-index="{{@index}}" title="Remove"><i class="fas fa-trash"></i></button>
      </div>
      <div class="char-card-body">
        <div class="char-card-col">
          <h4>Crit</h4>
          <div class="form-group">
            <label>Image</label>
            <div class="form-fields">
              <input type="text" name="rows.{{@index}}.critFile" value="{{critFile}}">
              <button type="button" data-action="pickImage" data-target="rows.{{@index}}.critFile"><i class="fas fa-file-import"></i></button>
            </div>
          </div>
          <div class="form-group">
            <label>Sound</label>
            <div class="form-fields">
              <input type="text" name="rows.{{@index}}.critSound" value="{{critSound}}">
              <button type="button" data-action="pickImage" data-target="rows.{{@index}}.critSound" data-picker-type="audio"><i class="fas fa-music"></i></button>
            </div>
          </div>
        </div>
        <div class="char-card-col">
          <h4>Fumble</h4>
          <div class="form-group">
            <label>Image</label>
            <div class="form-fields">
              <input type="text" name="rows.{{@index}}.fumbleFile" value="{{fumbleFile}}">
              <button type="button" data-action="pickImage" data-target="rows.{{@index}}.fumbleFile"><i class="fas fa-file-import"></i></button>
            </div>
          </div>
          <div class="form-group">
            <label>Sound</label>
            <div class="form-fields">
              <input type="text" name="rows.{{@index}}.fumbleSound" value="{{fumbleSound}}">
              <button type="button" data-action="pickImage" data-target="rows.{{@index}}.fumbleSound" data-picker-type="audio"><i class="fas fa-music"></i></button>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{/each}}

    <button type="button" data-action="addRow"><i class="fas fa-plus"></i> Add Character</button>
  </details>

  <footer class="sheet-footer">
    <button type="submit"><i class="fas fa-save"></i> Save</button>
  </footer>
</div>
